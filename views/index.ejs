<%layout("/layouts/boylerpalate")%> <%=success%>
<style>
 .filter{
   text-align: center;
   margin-right: 2rem;
   margin-top:1rem;
   opacity: 0.75;
  } 
  #filter{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    
  }
  #filter:hover{
      opacity: 1;
      cursor: pointer;
    }
.tax-info{
     display:none;
}
.switch {
  border: 2px solid rgb(109, 104, 104);
  border-radius: 1rem;
  height: 3.5rem;
  padding:1rem;
  width:15rem;
  margin-right:8px;
}

.form-check-reverse.form-switch .form-check-input {
  margin-left: 2px;
  margin-right: 0;
}

</style>
<body>
  <div id="filter">
    <div class="filter">
      <div>
        <i class="fa-solid fa-fire"></i>
        <p>listing</p>
      </div>
     </div>
      <div class="filter">
        <div>
        <i class="fa-regular fa-flag"></i>
         <p>Room</p>
        </div>
      </div>
      <div class="filter">
        <div>
           <i class="fa-solid fa-street-view"></i>
           <p>popular views</p>
        </div>
      </div>
      <div class="filter">
        <div>
          <i class="fa-solid fa-mountain"></i>
           <p>Mountains</p>
        </div>
      </div>
      <div class="filter">
        <div>
       <i class="fa-solid fa-house"></i>
           <p>Castel</p>
        </div>
      </div>
      <div class="filter">
        <div>
         <i class="fa-solid fa-pen"></i>
           <p>pool</p>
        </div>
      </div>
      <div class="filter">
        <div>
          <i class="fa-solid fa-magnet"></i>
           <p>Magnetic</p>
        </div>
      </div>
      <div class="filter">
        <div>
           <i class="fa-solid fa-bath"></i>
           <p>Arabic</p>
        </div>
      </div>
      <div class="filter">
        <div>
          <i class="fa-solid fa-hill-avalanche"></i>
          <p>Charming</p>
        </div>
      </div>
      <div class="filter">
        <div>
         <i class="fa-solid fa-lemon"></i>
           <p> 360 views</p>
        </div>
      </div>
      <div class="filter">
        <div>
          <i class="fa-brands fa-airbnb"></i>
           <p>Airbnb</p>
        </div>
      </div>
      <div class="filter">
        <div>
           <i class="fa-solid fa-binoculars"></i>
           <p>Binocolours</p>
        </div>
      </div>
<div class="form-check-reverse form-switch switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">display total before tax</label>
</div>
  </div>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <%for(let list of allListing){%>
    <div class="col">
      <a href="listings/<%=list.id%>" class="listing-link text-decoration-none">
        <div class="card h-100 listing-card ">
          <img src=<%=list.image.url%> alt="..." class="card-img-top" style="height: 20rem; object-fit: cover;">
          <div class="card-img-overlay">abcd</div>
          <div class="card-body">
            <p class="card-text">
              <%=list.title%>
              <br>
              ₹ <%=list.price%>
              <i class="tax-info">&nbsp &nbsp +18% GST</i>
            </p> 
          </div>
        </div>
      </a>
    </div>
  <%}%>
  </div>
  
  
</body>
<script>
  let taxSwitch=document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
   let show_tax = document.getElementsByClassName("tax-info");
     for(let info of show_tax){
      if(info.style.display!="inline"){
         info.style.display="inline";
      }
      else{
        info.style.display = "none"
      }
       
   }
 
  
  })
</script>